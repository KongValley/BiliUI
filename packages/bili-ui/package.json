{
  "name": "bili-ui",
  "version": "0.1.0",
  "description": "Bili UI - a modern Vue 3 PC component library.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "component-library",
    "ui",
    "bili-ui"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "build": "vite build && pnpm build:style",
    "build:style": "sass --no-source-map --style=compressed src/styles/index.scss dist/index.css",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.0",
    "sass": "^1.108.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  }
}
